# Copy to .env and adjust. install.sh does this for you on first run.

# Docker image to run (official image)
IMAGE=dujiaonext/dujiao-next
TAG=latest

# Where the app port is published on the host.
# 127.0.0.1 = reachable only on this machine (use the Caddy proxy profile
# or your own reverse proxy for public traffic).
# 0.0.0.0   = expose the app port directly on all interfaces.
BIND_ADDR=127.0.0.1
APP_PORT=8080

# Your shop domain, required only for the Caddy "proxy" profile
# (automatic HTTPS via Let's Encrypt). Example: shop.example.com
SITE_DOMAIN=
